      "EVM_NETWORK",
      "SVM_NETWORK",
      "AVM_NETWORK",
      "APTOS_NETWORK",
      "HEDERA_NETWORK",
      "HEDERA_NODE_URL",
      "STELLAR_NETWORK",
      "CARDANO_MNEMONIC",
      "CARDANO_NETWORK",
      "BLOCKFROST_PROJECT_ID",
      "BLOCKFROST_PREPROD_URL",
      "TVM_NETWORK",
      "TVM_PROVIDER",
      "TONCENTER_API_KEY",
      "TONCENTER_BASE_URL",
      "TONAPI_API_KEY",
