{
  "name": "typescript",
  "type": "facilitator",
  "language": "typescript",
  "protocolFamilies": [
    "evm",
    "svm",
    "avm",
    "aptos",
    "hedera",
    "keeta",
    "stellar",
    "tvm",
    "cardano"
